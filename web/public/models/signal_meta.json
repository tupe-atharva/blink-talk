{
  "classes": [
    "brow_up",
    "idle",
    "left",
    "long_blink",
    "natural_blink",
    "right"
  ],
  "features": [
    "blink_rel_mean",
    "blink_rel_min",
    "blink_rel_max",
    "blink_rel_last",
    "blink_rel_slope",
    "h_rel_mean",
    "h_rel_min",
    "h_rel_max",
    "h_rel_last",
    "h_rel_slope",
    "lookA_rel_mean",
    "lookA_rel_min",
    "lookA_rel_max",
    "lookA_rel_last",
    "lookA_rel_slope",
    "lookB_rel_mean",
    "lookB_rel_min",
    "lookB_rel_max",
    "lookB_rel_last",
    "lookB_rel_slope",
    "brow_rel_mean",
    "brow_rel_min",
    "brow_rel_max",
    "brow_rel_last",
    "brow_rel_slope",
    "yaw_rel_mean",
    "yaw_rel_min",
    "yaw_rel_max",
    "yaw_rel_last",
    "yaw_rel_slope",
    "pitch_rel_mean",
    "pitch_rel_min",
    "pitch_rel_max",
    "pitch_rel_last",
    "pitch_rel_slope",
    "jaw_mean",
    "jaw_min",
    "jaw_max",
    "jaw_last",
    "jaw_slope",
    "smile_mean",
    "smile_min",
    "smile_max",
    "smile_last",
    "smile_slope",
    "closed_dur",
    "longest_closure",
    "n_closures",
    "frac_closed",
    "since_closure"
  ],
  "series": [
    "blink_rel",
    "h_rel",
    "lookA_rel",
    "lookB_rel",
    "brow_rel",
    "yaw_rel",
    "pitch_rel",
    "jaw",
    "smile"
  ],
  "stats": [
    "mean",
    "min",
    "max",
    "last",
    "slope"
  ],
  "input": "input",
  "outputs": [
    "label",
    "probabilities"
  ],
  "window_s": 1.0,
  "step_s": 0.1,
  "closed_delta": 0.3,
  "rest_keys": [
    "blink",
    "h",
    "lookA",
    "lookB",
    "brow",
    "yaw",
    "pitch"
  ],
  "decode": {
    "p_min": 0.5,
    "consec": {
      "select": 2,
      "move": 6,
      "undo": 2
    },
    "rearm_p_idle": 0.5,
    "select_min_s": 0.6,
    "head_gate_deg": 8.0
  },
  "definitions": {
    "h": "lookA - lookB",
    "jaw": "jawOpen",
    "smile": "(mouthSmileLeft + mouthSmileRight)/2",
    "*_rel": "value - rest value from calibration (rest step median)",
    "closed": "blink_rel > closed_delta",
    "slope": "least-squares slope per second over the window (time in seconds)",
    "closed_dur": "seconds the eyes have been closed continuously at the window end (0 if open)",
    "longest_closure": "longest closed run inside the window, seconds",
    "n_closures": "number of closed runs inside the window",
    "frac_closed": "fraction of window frames that are closed",
    "since_closure": "0 if closed at window end; else seconds since the last closed run ended (max 1.0)"
  },
  "trained_on": [
    "atharvatupe",
    "omwaikar",
    "udayanjadhav",
    "yashvarpe"
  ],
  "trees_file": "signal_trees.json"
}